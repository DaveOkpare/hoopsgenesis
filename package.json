{
  "name": "hoops-genesis",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @hoops-genesis/db --",
    "db:studio": "turbo run db:studio -F @hoops-genesis/db --",
    "db:generate": "turbo run db:generate -F @hoops-genesis/db --",
    "db:migrate": "turbo run db:migrate -F @hoops-genesis/db --",
    "db:start": "turbo run db:start -F @hoops-genesis/db --",
    "db:watch": "turbo run db:watch -F @hoops-genesis/db --",
    "db:stop": "turbo run db:stop -F @hoops-genesis/db --",
    "db:down": "turbo run db:down -F @hoops-genesis/db --",
    "deploy:setup": "pnpm dlx vercel link",
    "dev:vercel": "pnpm dlx vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "pnpm dlx vercel deploy",
    "deploy:prod": "pnpm dlx vercel deploy --prod",
    "deploy:check": "pnpm dlx vercel deploy --dry",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && pnpm run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hoops-genesis/config": "workspace:*",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.16.1"
}
