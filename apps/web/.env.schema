# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The app's public origin. Not a secret: invitation-code links
# (<BETTER_AUTH_URL>/join/<code>) are built from it and sent in responses.
# @sensitive=false @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# Used only by Prisma CLI commands such as migrations. Set it when DATABASE_URL
# is a transaction pooler (for example Supabase on port 6543), which migrations
# cannot run through: point this at a direct or session-mode connection.
# @required=false @type=string(minLength=1)
DATABASE_DIRECT_URL=

# --- Record file storage (student records and uploads) ---
# Any S3-compatible service: AWS S3, Supabase Storage (S3 endpoint), Cloudflare
# R2, MinIO. The bucket must be private. Storage counts as configured when the
# bucket, region and both keys are set; otherwise POST /uploads and record file
# URLs answer 503 storage_not_configured and records without files still work.
# Add a bucket lifecycle rule that deletes objects under tmp/ after 24 hours.
# Endpoint: e.g. https://<account>.r2.cloudflarestorage.com, or
# https://<project>.supabase.co/storage/v1/s3. Leave empty for AWS S3
# (https://s3.<region>.amazonaws.com).
# @required=false @sensitive=false @type=url
STORAGE_S3_ENDPOINT=
# e.g. us-east-1; "auto" for R2; the project's region for Supabase.
# @required=false @sensitive=false @type=string(minLength=1)
STORAGE_S3_REGION=
# @required=false @sensitive=false @type=string(minLength=3)
STORAGE_S3_BUCKET=
# @required=false @type=string(minLength=1)
STORAGE_S3_ACCESS_KEY_ID=
# @required=false @type=string(minLength=1)
STORAGE_S3_SECRET_ACCESS_KEY=
# true for path-style URLs (endpoint/bucket/key): needed for MinIO and Supabase.
# @required=false @sensitive=false @type=boolean
STORAGE_S3_FORCE_PATH_STYLE=false

# --- Payment webhooks (fees) ---
# Shared secret for the built-in "generic" payment provider at
# POST /api/v1/webhooks/payments/generic: the sender signs each request with
# HMAC-SHA256 over "<timestamp>.<raw body>" using this value. Leave it unset
# to turn the generic webhook off (requests then get 404).
# @required=false @type=string(minLength=32)
PAYMENT_WEBHOOK_GENERIC_SECRET=
