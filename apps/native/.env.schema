# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# Dev-only UI preview. When true (and only in __DEV__ builds) the app skips the
# session check and serves fixture data, so screens render without a backend.
# @public @type=boolean @required=false
EXPO_PUBLIC_UI_PREVIEW=false

# Which role "/" opens in preview mode. Routes under /student, /coach and /admin
# always preview as their own role.
# @public @type=enum(student, coach, admin) @required=false
EXPO_PUBLIC_UI_PREVIEW_ROLE=student
